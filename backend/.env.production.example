# ==============================================================================
# PCP INDUSTRIAL — CONFIGURAÇÃO DO AMBIENTE DE PRODUÇÃO (EXEMPLO)
# ==============================================================================
# INSTRUÇÕES DE INSTALAÇÃO:
# 1. Copie este arquivo para .env.production no mesmo diretório (backend/.env.production).
# 2. Preencha todos os campos obrigatórios com valores reais e senhas seguras.
# 3. NUNCA versione o arquivo .env.production no Git ou envie senhas por canais públicos.
# ==============================================================================

# 1. AMBIENTE OPERACIONAL DO SERVIDOR
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Origem permitida para requisições CORS
# No modelo de build integrado (frontend servido na porta 4000 pelo próprio Express), use "*" ou o IP/domínio da LAN
CORS_ORIGIN="*"

# 2. BANCO DE DADOS DE PRODUÇÃO (SQLite Isolado)
# OBRIGATÓRIO: Deve apontar para um arquivo dedicado de produção.
# O sistema bloqueia categoricamente apontamentos para "dev.db" ou "test.db".
# Exemplo relativo: file:./prisma/production.db
# Exemplo absoluto no Windows: file:C:/dados/pcp/production.db
DATABASE_URL="file:./prisma/production.db"

# 3. ARMAZENAMENTO DE UPLOADS E ARQUIVOS (Artes, Mockups e Comprovantes)
# OBRIGATÓRIO: Deve ser uma pasta exclusiva de produção, separada de "backend/uploads/".
# Exemplo relativo: ./production_uploads
# Exemplo absoluto no Windows: C:/dados/pcp/uploads
UPLOADS_DIR="./production_uploads"

# 4. CHAVES CRIPTOGRÁFICAS DE ALTA ENTROPIA (Mínimo de 32 caracteres cada)
# ATENÇÃO: Nunca reutilize as chaves padrão de desenvolvimento.
# Para gerar chaves criptográficas fortes, execute no terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Assinatura de Tokens de Autenticação JWT (Sessão dos Operadores e Gestores)
JWT_SECRET=
JWT_EXPIRES_IN="12h"

# Assinatura Digital Operacional HMAC-SHA256 (Romaneios, Lotes e QR Codes)
# O sistema aceita HMAC_SIGNATURE_SECRET (preferencial) ou HMAC_SECRET
HMAC_SIGNATURE_SECRET=

# 5. POLÍTICA DE BACKUP AUTOMÁTICO E RETENÇÃO
# Quantidade máxima de snapshots completos mantidos no disco antes de purgar os mais antigos (Padrão: 7)
BACKUP_RETENTION_COUNT=14

# 6. CREDENCIAIS INICIAIS DO ADMINISTRADOR GERAL (Script init-production-db.ts)
# Utilizadas única e exclusivamente no primeiro provisionamento do banco de produção.
# Regras de Segurança:
# - ADMIN_EMAIL: E-mail corporativo válido (não pode ser admin@fabrica.com)
# - ADMIN_PASSWORD: Senha forte com no mínimo 8 caracteres (não pode ser admin123)
# - ADMIN_PIN: PIN numérico de 4 a 8 dígitos para assinatura digital (não pode ser 1234 ou 123456)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PIN=
