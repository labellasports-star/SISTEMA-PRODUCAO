# ==============================================================================
# PCP INDUSTRIAL — CONFIGURAÇÃO DO AMBIENTE DE PRODUÇÃO (EXEMPLO)
# ==============================================================================
# Copie este arquivo para .env.production e preencha as variáveis com valores reais.
# NUNCA versione o arquivo .env.production com segredos ou senhas reais.
# ==============================================================================

# Ambiente operacional
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Banco de Dados de Produção (SQLite isolado de dev.db e test.db)
# Exemplo: file:/var/data/pcp_production.db ou file:./prisma/production.db
DATABASE_URL=

# Diretório de Armazenamento de Arquivos de Produção
# OBRIGATÓRIO: Deve ser separado de backend/uploads/
# Exemplo: /var/data/pcp_uploads ou ./uploads_production
UPLOADS_DIR=

# Chaves Criptográficas de Alta Entropia (Mínimo de 32 caracteres cada)
# DICA: Gere com `openssl rand -hex 32` ou `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN="12h"
HMAC_SECRET=

# Credenciais Iniciais do Administrador do Sistema (Utilizadas pelo script init-production-db.ts)
# - Senha com no mínimo 12 caracteres
# - PIN com 6 dígitos numéricos
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PIN=
