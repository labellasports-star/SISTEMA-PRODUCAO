# Configurações do Servidor
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Autenticação e Criptografia (OBRIGATÓRIOS)
# JWT_SECRET: Chave secreta de alta entropia para assinatura dos tokens JWT
JWT_SECRET="insira_aqui_sua_chave_jwt_secreta_de_alta_entropia"
JWT_EXPIRES_IN="12h"

# Assinatura Digital Operacional de Chão de Fábrica (OBRIGATÓRIO)
# HMAC_SIGNATURE_SECRET: Chave secreta para assinatura HMAC-SHA-256 das movimentações de lotes
HMAC_SIGNATURE_SECRET="insira_aqui_sua_chave_hmac_secreta_de_alta_entropia"

# CORS
CORS_ORIGIN="*"
