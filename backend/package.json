{
  "name": "sistema-pcp-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend do Sistema de Gestão de Produção e Rastreabilidade Industrial (PCP)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx scripts/start-prod.ts",
    "start:prod": "tsx scripts/start-prod.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:init:prod": "tsx scripts/init-production-db.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "backup:restore": "tsx scripts/restore.ts",
    "test": "tsx test/run-all-tests.ts"
  },
  "keywords": [
    "pcp",
    "industria",
    "rastreabilidade",
    "uniformes"
  ],
  "author": "PCP Industrial Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
